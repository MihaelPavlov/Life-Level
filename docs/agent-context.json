        "description": "Boss/mini-boss mechanics, chest encounters, damage formula, XP rewards",
        "entities": [
          "Boss (Id, Name, Icon, MaxHp, RewardXp, TimerDays, IsMini, SuppressExpiry, NodeId?, WorldZoneId?)",
          "Chest (Id, EncounterId, LootTableId, IsOpened)",
          "UserBossState (Id, UserId, BossId, HpDealt, IsDefeated, IsExpired, StartedAt, DefeatedAt, UserMapProgressId?)",
          "UserChestState (Id, UserId, ChestId, IsOpened, OpenedAt)"
        ],
        "services": ["BossService", "ChestService"],
        "portsImplemented": ["IBossDefeatedCountReadPort", "IBossDefeatReadPort"]
      },
      {
        "name": "Adventure.Dungeons",
        "description": "Dungeon floor progression, crossroads branching, path choice tracking",
        "entities": [
          "DungeonFloor (Id, DungeonId, FloorNumber, Difficulty)",
          "DungeonPortal (Id, NodeId, LeadsToZoneId, IsUsable)",
          "Crossroads (Id, NodeId, Description)",
          "CrossroadsPath (Id, CrossroadsId, PathName, LeadsToNodeId)",
          "UserDungeonState (Id, UserId, CurrentFloorId)",
          "UserCrossroadsState (Id, UserId, CrossroadsId, ChosenPathId?)"
        ],
        "services": ["DungeonService", "CrossroadsService"]
      },
      {
        "name": "Items",
        "description": "21-item catalog, 5 equip slots, gear stat bonuses",
        "entities": [
          "Item (Id, Name, Icon, Rarity, Slot, StrBonus, EndBonus, AgiBonus, FlxBonus, StaBonus, IsActive, UnlockLevel)",
          "CharacterItem (CharacterId, ItemId, IsEquipped)",
          "EquipmentSlot (Id, SlotName, MaxItems)",
          "ItemDropRule (ItemId, TriggerType, Probability, UnlockLevel)"
        ],
        "slots": ["weapon", "armor", "helm", "gloves", "trinket"],
        "rarities": ["Common (green)", "Rare (blue)", "Epic (purple)", "Legendary (orange)"],
        "services": ["ItemService", "ItemGrantService"],
        "portsImplemented": ["IGearBonusReadPort", "ILevelUpItemGrantPort", "IInventorySlotReadPort"]
      },
      {
