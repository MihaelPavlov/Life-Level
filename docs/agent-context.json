  "project": {
    "name": "Life-Level",
    "tagline": "Fitness RPG: train in real world → progress in game world",
    "stack": {
      "mobile": "Flutter (Dart 3) + Riverpod — single codebase iOS + Android",
      "backend": "ASP.NET Core 8 (C#) — modular monolith, ports-and-adapters",
      "database": "Supabase PostgreSQL connected via EF Core + Npgsql",
      "auth": "JWT HS256, 24h expiry, issued by Identity module (NOT Supabase Auth)",
      "cache": "Redis — sorted sets for leaderboards, XP storm state",
      "notifications": "Firebase FCM (project: life-level-ae77f)",
      "realtime": "SignalR — planned for guild raids (LL-016, not yet integrated)",
      "integrations": ["Strava OAuth (ClientId 218444)", "Garmin OAuth (ClientId in config)", "Google Health Connect (Android)", "HealthKit (iOS)"]
    },
    "principle": "Supabase is infrastructure only (managed Postgres + storage). All auth, game logic, XP calculations, and business rules live exclusively in ASP.NET Core."
  },

  "architecture": {
    "pattern": "modular-monolith with ports-and-adapters",
    "compositionRoot": "LifeLevel.Api",
    "compositionRootResponsibilities": [
      "24 controllers (no business logic — thin HTTP adapters only)",
      "Single AppDbContext (41 DbSets)",
      "EF Core migrations",
      "WorldSeeder (cross-module seeder, must stay in composition root)",
      "MapService (cross-module entity loading, stays in composition root to avoid DAG cycles)",
      "DI registration of all port implementations",
      "AppDbContext.OnModelCreating calls ApplyConfigurationsFromAssembly() for each module"
    ],
    "moduleDAG": {
      "leafModules": ["Identity", "Character", "Activity", "Quest", "Streak", "LoginReward", "WorldZone", "Notifications", "Integrations", "Items", "Achievements"],
      "mapLayer": "Map (depends on SharedKernel only)",
      "adventureLayer": ["Adventure.Encounters (depends on SharedKernel + Map)", "Adventure.Dungeons (depends on SharedKernel + Map)"],
      "sharedKernel": "SharedKernel (no dependencies — port interfaces, contracts, domain events, shared enums)"
    },
    "crossModuleCommunicationRules": {
      "rule1": "Modules NEVER reference each other's concrete classes or services.",
      "rule2": "Cross-module calls use SharedKernel port interfaces only.",
      "rule3": "Port implementations live in the implementing module, registered in LifeLevel.Api DI.",
      "tier1SyncPorts": "Direct port calls within the same DB transaction (Activity → ICharacterXpPort, etc.)",
      "tier2DomainEvents": "Domain events fired after SaveChanges (ActivityLoggedEvent, CharacterLeveledUpEvent, etc.)"
    },
    "tier1SyncPortCalls": [
      {"caller": "Activity", "port": "ICharacterXpPort.AwardXpAsync()", "implementor": "Character"},
      {"caller": "Activity", "port": "ICharacterStatPort.ApplyStatGainsAsync()", "implementor": "Character"},
      {"caller": "Activity", "port": "IWorldZoneDistancePort.AddDistanceAsync()", "implementor": "WorldZone"},
      {"caller": "Activity", "port": "IWorldDungeonActivityPort.CreditActivityAsync()", "implementor": "WorldZone"},
      {"caller": "Activity", "port": "IGearBonusReadPort.GetEquippedBonusesAsync()", "implementor": "Items"},
      {"caller": "Activity", "port": "ICharacterTutorialPort.AdvanceIfOnStepAsync()", "implementor": "Character"},
      {"caller": "Character.GetProfile", "port": "IStreakReadPort.GetCurrentStreakAsync()", "implementor": "Streak"},
      {"caller": "Character.GetProfile", "port": "ILoginRewardReadPort.HasClaimedTodayAsync()", "implementor": "LoginReward"},
      {"caller": "Character.GetProfile", "port": "IDailyQuestReadPort.CountCompletedDailyQuestsAsync()", "implementor": "Quest"},
      {"caller": "LoginReward", "port": "IStreakShieldPort.AddShieldAsync()", "implementor": "Streak"},
      {"caller": "Boss defeat", "port": "ICharacterXpPort.AwardXpAsync()", "implementor": "Character"},
      {"caller": "Integrations webhooks", "port": "IActivityLogPort.LogActivityAsync()", "implementor": "Activity"}
    ],
    "tier2DomainEvents": [
      {"event": "ActivityLoggedEvent", "handlers": ["StreakActivityHandler (increment streak)", "QuestActivityHandler (update quest progress)"]},
      {"event": "UserRegisteredEvent", "handlers": ["CharacterCreatedHandler (create Character entity at level 1)"]},
      {"event": "StreakBrokenEvent", "handlers": ["StreakBrokenNotificationHandler (send FCM push via INotificationPort)"]},
      {"event": "CharacterLeveledUpEvent", "handlers": ["LevelUpUnlockHandler (ILevelUpItemGrantPort, IZoneUnlockReadPort, ITitleUnlockPort)"]}
    ]
  },

  "backend": {
    "modules": [
      {
        "name": "SharedKernel",
        "description": "Port interfaces, domain event framework, shared enums. No dependencies.",
        "sharedEnums": ["ActivityType (Run, Cycle, Swim, Walk, Sport, Strength, Yoga, Custom)", "UserRole"],
        "portCount": 31
      },
      {
        "name": "Identity",
        "description": "Auth, JWT, user registration",
        "entities": ["User (Id, Username, Email, PasswordHash, CreatedAt)", "UserRingItem (equipment ring state)"],
        "services": ["AuthService (register, login, JWT)", "JwtService (HS256 token gen/validate)"],
        "eventsRaised": ["UserRegisteredEvent"],
        "portsImplemented": ["IUserReadPort"]
      },
      {
        "name": "Character",
        "description": "XP/stat engine, level progression, titles, tutorial tracking",
        "entities": [
          "Character (Id, UserId, Level, Xp, Rank, Str, End, Agi, Flx, Sta, AvailableStatPoints, MaxInventorySlots, ClassId, AvatarEmoji, IsSetupComplete, EquippedTitleId, TutorialStep, TutorialCompletedAt, TutorialRewardsClaimed, TutorialTopicsSeen)",
          "CharacterClass (Id, Name, Emoji, StrMultiplier, EndMultiplier, AgiMultiplier, FlxMultiplier, StaMultiplier, IsActive)",
          "XpHistoryEntry (CharacterId, Source, XpAwarded, NewLevel, CreatedAt)",
          "Title (Id, Name, Icon, Rarity, stat bonuses, UnlockLevel, IsBoss, IsActive)",
          "CharacterTitle (CharacterId, TitleId, UnlockedAt, IsEquipped)"
        ],
        "services": ["CharacterService", "TitleService", "TutorialService"],
        "portsImplemented": ["ICharacterXpPort", "ICharacterStatPort", "ICharacterLevelReadPort", "ICharacterIdReadPort", "ICharacterInfoPort", "ICharacterTutorialPort", "ITitleUnlockPort"]
      },
      {
        "name": "Activity",
        "description": "Log workouts, calculate XP/stat gains, trigger cross-module effects",
        "entities": [
          "Activity (Id, CharacterId, Type, DurationMinutes, DistanceKm, Calories, HeartRateAvg, XpGained, StrGained, EndGained, AgiGained, FlxGained, StaGained, Steps, LoggedAt)"
        ],
        "services": ["ActivityService (CalculateGains, port dispatch)"],
        "eventsRaised": ["ActivityLoggedEvent"],
        "portsImplemented": ["IActivityLogPort", "IActivityStatsReadPort", "IActivityExternalIdReadPort", "IActivityHistoryReadPort", "IActivityBossDamagePort"]
      },
      {
        "name": "Quest",
        "description": "Daily/weekly/special quests, generation cron, progress tracking",
        "entities": [
          "Quest (Id, Name, Description, Type, TargetValue, RewardXp, IsActive)",
          "UserQuestProgress (UserId, QuestId, CurrentValue, IsCompleted, RewardClaimed, AssignedAt, ExpiresAt)"
        ],
        "services": ["QuestService (GenerateDailyQuestsAsync, progress update)"],
        "portsImplemented": ["IDailyQuestReadPort", "IQuestProgressPort"]
      },
      {
        "name": "Streak",
        "description": "Daily streaks, shields, break logic, milestones",
        "entities": [
          "Streak (Id, UserId, Current, Longest, Shields, ShieldsUsed, ShieldUsedToday, TotalDaysActive, LastActivityDate, LastStreakBrokenAt, LastBrokenFromLength)"
        ],
        "services": ["StreakService", "StreakBrokenNotificationHandler"],
        "eventsRaised": ["StreakBrokenEvent"],
        "portsImplemented": ["IStreakReadPort", "IStreakShieldPort", "IStreakDailyReset"]
      },
      {
        "name": "LoginReward",
        "description": "7-day login cycle, XP Storm flag",
        "entities": [
          "LoginReward (Id, UserId, CurrentDay 1-7, ClaimedToday, LastClaimDate, IsXpStorm)"
        ],
        "services": ["LoginRewardService"],
        "portsImplemented": ["ILoginRewardReadPort", "ILoginRewardDailyReset"]
      },
      {
        "name": "Map",
        "description": "Local dungeon layer — node/edge graph, encounters, distance movement",
        "note": "MapService lives in LifeLevel.Api (composition root) to avoid DAG cycles",
        "entities": [
          "MapNode (Id, MapId, Name, Region, Icon, LevelRequirement, NodeType, EncounterId?)",
          "MapEdge (Id, MapId, SourceNodeId, TargetNodeId, DistanceKm)",
          "UserMapProgress (Id, UserId, CurrentNodeId)",
          "UserNodeUnlock (UserId, NodeId, UnlockedAt)"
        ],
        "portsImplemented": ["IMapProgressReadPort", "IMapNodeCountPort", "IMapNodeCompletedCountPort"]
      },
      {
        "name": "WorldZone",
        "description": "Overworld layer — zone/edge graph, zone-scoped dungeons, distance-driven travel",
        "entities": [
          "World (Id, Name, Description)",
          "Region (Id, WorldId, Name)",
          "WorldZone (Id, RegionId, Name, Icon, Description, UnlockLevel, DistanceToNext)",
          "WorldZoneEdge (Id, SourceZoneId, TargetZoneId, DistanceKm)",
          "UserWorldProgress (Id, UserId, DestinationZoneId?, DistanceTraveledOnEdge)",
          "UserZoneUnlock (UserId, ZoneId, UnlockedAt)",
          "UserPathChoice (UserId, CrossroadsId, ChosenPathId)",
          "UserWorldChestState (UserId, ChestId, IsOpened)",
          "WorldZoneDungeonFloor (Id, ZoneId, FloorNumber)",
          "UserWorldDungeonState (UserId, ZoneId, CurrentFloorIndex)",
          "UserWorldDungeonFloorState (UserWorldDungeonStateId, FloorIndex, IsCompleted)"
        ],
        "services": ["WorldZoneService", "WorldChestService", "WorldDungeonService", "WorldBossBridgeService"],
        "portsImplemented": ["IWorldZoneDistancePort", "IWorldZoneCompletionPort", "IWorldDungeonActivityPort", "IZoneUnlockReadPort", "IBossSpawnPort"]
      },
