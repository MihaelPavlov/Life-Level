          "UserAchievement (UserId, AchievementId, UnlockedAt, Progress)"
        ],
        "tiers": ["Common", "Uncommon", "Rare", "Epic", "Legendary"],
        "services": ["AchievementService"]
      },
      {
        "name": "Notifications",
        "description": "FCM push delivery, in-app notification feed, cadence policy",
        "entities": [
          "DeviceToken (UserId, Token, IsActive, RegisteredAt)",
          "NotificationLog (UserId, Category, Title, Body, DeepLinkPath, IsRead, CreatedAt)"
        ],
        "services": ["NotificationService"],
        "portsImplemented": ["INotificationPort"]
      },
      {
        "name": "Integrations",
        "description": "Strava/Garmin OAuth + webhooks, Health Connect sync, activity dedup",
        "entities": [
          "StravaConnection (UserId, StravaUserId, AccessToken, RefreshToken, ExpiresAt, IsConnected)",
