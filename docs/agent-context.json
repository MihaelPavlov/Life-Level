  "gameEngine": {
    "xpFormula": {
      "description": "ActivityService.CalculateGains() — called on POST /api/activity/log",
      "steps": [
        "baseXp = durationMinutes × 10",
        "typeModifier: Run/Cycle=1.0, Swim=1.2, Walk=0.75, Sport=1.1, Strength=1.3, Yoga=0.9, Custom=1.0",
        "gearBonus = IGearBonusReadPort.GetEquippedBonusesAsync(userId).XpBonusPct (from equipped items)",
        "finalXp = (int)(baseXp × typeModifier × (1 + gearBonus / 100))",
        "XP Storm ×2: NOT YET WIRED (LL-001 in progress) — LoginReward.IsXpStorm flag exists but multiplier not applied"
      ],
      "output": "{xp, str, end, agi, flx, sta}"
    },
    "statGains": {
      "description": "Scaled to durationMinutes. CharacterClass multipliers further scale each stat.",
      "byActivity": {
        "Run": {"END": "high", "AGI": "medium", "STA": "low"},
        "Cycle": {"END": "high", "AGI": "medium", "STA": "low"},
        "Swim": {"STR": "low", "END": "medium", "FLX": "low", "STA": "medium"},
        "Walk": {"END": "low", "AGI": "low", "STA": "low"},
        "Sport": {"STR": "low", "END": "low", "AGI": "high", "STA": "low"},
        "Strength": {"STR": "high", "STA": "medium"},
        "Yoga": {"FLX": "high", "STA": "low"},
        "Custom": {"STA": "low"}
      }
    },
    "levelProgression": {
      "formula": "threshold(N) = N × 1000 XP (cumulative)",
      "examples": {"1": 1000, "2": 2000, "5": 5000, "10": 10000},
      "onLevelUp": [
        "Character.Level++, Character.AvailableStatPoints++",
        "CharacterLeveledUpEvent fired → LevelUpUnlockHandler",
        "Items granted if Item.UnlockLevel == newLevel",
        "Zones unlocked if WorldZone.UnlockLevel == newLevel",
        "Title unlocked if Title.UnlockLevel == newLevel",
        "Mobile: leveledUp:true in response → LevelUpNotifier.emit() → MainShell overlay"
      ]
    },
    "bossDamageFormula": {
      "description": "BossService.CalculateDamageFromActivity()",
      "formula": "baseDamage = (durationMinutes / 30) + (int)(distanceKm / 2.0)",
      "typeMultipliers": {"Walk": 0.5, "Run": 1.0, "Cycle": 1.0, "Swim": 1.5, "Strength": 2.0, "Sport": 1.5, "Yoga": 0.5, "Custom": 1.0},
      "finalFormula": "finalDamage = max(1, (int)(baseDamage × typeMultiplier))",
      "bossHpRanges": "100–500+ (regular), smaller for mini-bosses",
      "timer": "7 days (regular boss); IsExpired set after TimerDays pass",
      "defeat": "HpDealt >= MaxHp → IsDefeated = true → AwardXp via ICharacterXpPort"
    },
    "streakRules": {
      "increment": "Activity logged → streak.Current++",
      "break": "No activity for 24h AND no shield available → Current = 0, LastStreakBrokenAt = now, StreakBrokenEvent fired → FCM push",
      "shieldUse": "streak.Shields--, ShieldUsedToday = true, Current preserved",
      "shieldAccrual": "Every 7 active days gains 1 shield. Max 3 shields.",
      "day7LoginReward": "Day 7 of login cycle → IsXpStorm = true on LoginReward entity + AddShieldAsync()",
      "milestoneThresholds": [3, 7, 14, 30, 60, 100],
      "atRiskNotification": "Planned at 20h idle (LL-036)"
    },
    "questGeneration": {
      "dailyCount": 5,
