{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lifelevel;Username=<username>;Password=<password>"
  },
  "SignalR": {
    "ChannelPrefix": "lifelevel-local"
  },
  "Jwt": {
    "Key": "<long-local-development-secret>",
    "Issuer": "LifeLevel",
    "Audience": "LifeLevel.Mobile"
  },
  "Firebase": {
    "ProjectId": "<firebase-project-id>",
    "CredentialsPath": "firebase-admin-key.json"
  },
  "GoogleAuth": {
    "ServerClientId": "<google-web-oauth-client-id>.apps.googleusercontent.com"
  },
  "AppleAuth": {
    "Audiences": [
      "com.lifelevel.app"
    ]
  },
  "Strava": {
    "ClientId": "<strava-client-id>",
    "ClientSecret": "<strava-client-secret>",
    "WebhookVerifyToken": "<strava-webhook-verify-token>"
  },
  "Garmin": {
    "ClientId": "<garmin-client-id>",
    "ClientSecret": "<garmin-client-secret>"
  },
  "BossCombat": {
    "V2Enabled": true
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1"
    }
  },
  "Waitlist": {
    "IpSalt": "<random-string-set-in-Render-as-Waitlist__IpSalt>"
  }
}
